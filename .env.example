# ---------------------------------------------------------------------------
# microCT Segmentation Lab — configuration
# Copy to ".env" and edit. ALL of these point OUTSIDE the git repo: your data,
# results, models, and the registry database are kept separate from the code.
# ---------------------------------------------------------------------------

# Root folder that holds your microCT datasets (each dataset = a folder of
# reconstructed *_rec*.bmp slices + a *_rec.log). Ingest scans this tree.
MICROCT_DATA_ROOT=D:/microct/datasets

# Where run outputs (masks, previews, per-run logs) are written & stored.
MICROCT_RESULTS_ROOT=D:/microct/results

# Root folder that holds trained nnU-Net model folders.
MICROCT_MODELS_ROOT=D:/microct/models

# App state: the registry SQLite DB + dataset thumbnails live here.
MICROCT_STATE_DIR=D:/microct/state

# Shared NAS ("Ultron") root as mapped ON THIS MACHINE. Dataset paths are stored
# relative to this so a record survives a different drive letter on another PC
# (e.g. Z:/ here, //ultron/share there). Leave unset to fall back to DATA_ROOT.
# MICROCT_NAS_ROOT=Z:/

# Folder holding analysis outputs (R code + figure images). Browsed via the app.
# Defaults to <NAS_ROOT>/Analyses, else <STATE_DIR>/analyses.
# MICROCT_ANALYSES_ROOT=Z:/Analyses

# Optional: override the SQLite location / use Postgres, e.g.
# MICROCT_DB_URL=postgresql+psycopg://user:pass@localhost/microct
# (default: sqlite in MICROCT_STATE_DIR/registry.db)

# Path to the segmentation script (defaults to <repo>/scripts/segment_microct.py)
# MICROCT_SEGMENT_SCRIPT=

# Python used to launch segmentation jobs (defaults to the current interpreter).
# Point this at the env that has torch + nnunetv2 installed if different.
# MICROCT_PYTHON_EXE=

# Web server bind. Use 0.0.0.0 to let colleagues on your LAN reach it.
MICROCT_HOST=127.0.0.1
MICROCT_PORT=8000

# Default compute device for new runs: auto | cuda | cpu
MICROCT_DEFAULT_DEVICE=auto

# How long (seconds) a run/measurement may sit in "canceling" before the API
# reports it as `stuck` and the interface offers a forced cancel. A cancel needs
# a WORKER to notice the flag and finish the row; with no worker running, nothing
# ever does, and the job blocks its dataset from being archived. Advisory only.
# MICROCT_STUCK_AFTER_SECONDS=120

# ---------------------------------------------------------------------------
# Morphometry (bone length / socket measurement) — anatomy gate
# ---------------------------------------------------------------------------
# The vendored digitpipe_v5 pipeline is built for MOUSE TERMINAL PHALANX at
# ~4 um. Pointed at any other anatomy it does not fail: it completes and returns
# confident, plausible, meaningless numbers. So a measurement is refused (HTTP
# 400) unless the dataset is tagged as that anatomy.
#
# Turn the gate off only if you know what the pipeline is being asked to measure
# and will judge the numbers yourself:
# MICROCT_MORPH_REQUIRE_ANATOMY=false
#
# Dataset tag(s) that mark a dataset as measurable. Comma-separated; a dataset
# needs any ONE of them. Matching is case-insensitive.
# MICROCT_MORPH_ANATOMY_TAGS=phalanx
#
# Past the anatomy gate, the MASK itself is checked before the pipeline starts —
# spacing, foreground fraction, and how fragmented it is. Socket detection alone
# is ~25 min of CPU, so a mask that could never yield a meaningful measurement is
# caught in the seconds it takes to count voxels. Blocking findings refuse the
# job; the rest are recorded on the result. Turn it off only to debug the check
# itself:
# MICROCT_MORPH_MASK_QC=false
#
# digitpipe_v5's geometry — its downsample factor, shrink-wrap percentiles and
# socket erosion radii — are voxel counts tuned for a 4 um grid. At another
# spacing they cover the wrong physical distance, so the mm values come out
# correctly scaled from a structurally wrong segmentation. A spacing more than 1%
# off 4 um is therefore refused. This downgrades that to a warning; the
# measurement record is stamped so the choice stays visible afterwards.
# MICROCT_MORPH_ALLOW_SPACING_MISMATCH=true

# ---------------------------------------------------------------------------
# Remote frontend (a UI hosted elsewhere, e.g. Vercel, talking to THIS server)
# ---------------------------------------------------------------------------
# The hosted page runs in your browser and calls this server on localhost — your
# data never leaves the machine. Name the page origin here and it just connects;
# no token is needed by default.
# MICROCT_ALLOWED_ORIGINS=https://microctweb.vercel.app
#
# OPTIONAL shared secret, for a shared or less trusted machine. Once set, the
# hosted UI must send it as `Authorization: Bearer <token>`. Pages served from
# THIS machine stay exempt, so the built-in dashboard keeps working unchanged.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# MICROCT_API_TOKEN=
#
# Demand the token from local callers too (default false):
# MICROCT_REQUIRE_TOKEN_LOCAL=true
#
# Serve a different frontend build at "/" — e.g. the Next.js static export, so
# the new UI runs same-origin with no CORS and no hosted deployment involved:
# MICROCT_WEB_DIR=C:/path/to/microctweb/out
